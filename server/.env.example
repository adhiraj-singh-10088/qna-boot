# Copy to .env and fill in your own values. Never commit the real .env.
# On hosting platforms (Vercel etc.) set these as environment variables in the
# dashboard instead — there is no .env file there.

# --- Server ---
PORT=3001

# --- TiDB Cloud database (MySQL-compatible) ---
DB_HOST=your-tidb-host
DB_PORT=4000
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# --- Auth ---
# Generate with: openssl rand -hex 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1h

# --- Optional tuning ---
# CORS_ORIGINS=http://localhost:5173,https://your-app.example.com
# DB_CONNECTION_LIMIT=5
# DB_CONNECT_TIMEOUT=20000
# UPLOADS_DIR=/some/writable/dir

# --- Optional rate-limit overrides ---
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_API_MAX=1000
